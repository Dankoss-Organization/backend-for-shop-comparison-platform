# Application
NODE_ENV=production
APP_ENV=production
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/shop_comparison

# Redis / BullMQ
REDIS_URL=rediss://default:password@ruling-mako-121880.upstash.io:6379

# Optional queue tuning
WORKER_CONCURRENCY=4
ENABLE_WORKER_THREADS=true
CPU_SIGNAL_ITERATIONS=20000
WORKER_THREAD_POOL_SIZE=2
ANALYTICS_WORKER_CONCURRENCY=2

# Grafana Loki Configuration
GRAFANA_LOKI_HOST=your-loki-host-url
GRAFANA_LOKI_USER=your-loki-user-id
GRAFANA_LOKI_TOKEN=your-loki-access-token

# Meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_API_KEY=development-key-change-in-prod
MEILISEARCH_INDEX_NAME=products
